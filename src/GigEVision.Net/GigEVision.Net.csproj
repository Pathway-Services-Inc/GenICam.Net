<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Renamed because the upstream project owns the GigEVision.Net id on nuget.org. -->
    <PackageId>GigEVisionDotNet</PackageId>
    <Description>.NET 8/9 implementation of the GigE Vision protocol (GVCP and GVSP) for industrial camera control and image streaming.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GigEVision.Net.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GenICam.Net\GenICam.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
  </ItemGroup>

</Project>
